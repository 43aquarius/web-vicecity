# web-vicecity relay 配置示例（复制为 .env 或直接在启动环境注入）
# 本分支默认分区见 config.json；以下全部可省略。

# PORT=8787
# HOST=0.0.0.0
# PART_START=361454906              # relay-b 分支默认 361454906（勿改，除非与主服务器同步调整）
# PART_END=722909812          # relay-b 分支默认 722909812
# ARCHIVE_URL=https://folder.morgen.qzz.io/revcdos.bin
# ARCHIVE_TOTAL=1084364719
# DATA_DIR=./data             # ≈361 MB 磁盘占用
# LIVE_FALLBACK=1             # 越界请求实时回源
# RELAY_TOKEN=                # 可选共享密钥
# MAX_LIVE_CONC=8
# SEED_CHUNK=8388608
