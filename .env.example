# Optional overrides — see README for the full list.
# REVCDOS_ARCHIVE_URL=https://folder.morgen.qzz.io/revcdos.bin
# REVCDOS_ARCHIVE_PATH=.revcdos-cache/revcdos.bin
# REVCDOS_PRELOAD=1            # boot-time preload (avoid on small containers)
# REVCDOS_DOWNLOAD=1           # download the full archive at startup (big-disk hosts)
# REVCDOS_INDEX_PATH=public/game/revcdos-index.json
#
# Multi-server partitioned relays (optional). When set, both this server's
# proxy and players' Service Workers route byte ranges to the relay servers:
# REVCDOS_RELAYS="a=https://relay-a.example.com/revcdos.bin:0-361454906,b=https://relay-b.example.com/revcdos.bin:361454906-722909812"
#
# DATABASE_URL=file:./db/custom.db
